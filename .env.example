# Copy to .env.local and insert your key. Never commit .env.local.
GEMINI_API_KEY=replace_me
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Despina
GEMINI_THINKING=low
GEMINI_MAX_HISTORY_TURNS=4
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_RETRY_MAX_OUTPUT_TOKENS=2048
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe
GEMINI_TRANSCRIPTION_TIMEOUT_S=20
# Set to a supported model for word timing, or leave as shown for fallback.
GEMINI_ALIGN_MODEL=gemini-3.5-transcribe
# pulse is recommended for a Bluetooth speaker; auto falls back to ALSA.
HEAD_AUDIO_BACKEND=auto
# Positive milliseconds delay mouth motion to match Bluetooth acoustic latency.
HEAD_AUDIO_LATENCY_MS=0
# Bound how far streamed PCM may lead real time; first audio is not delayed.
HEAD_AUDIO_MAX_AHEAD_MS=250
# Additional mouth-only delay after HEAD_AUDIO_LATENCY_MS; tune physically.
HEAD_MOUTH_OFFSET_MS=0
# Software-only lip-sync tuning. These do not alter servo endpoints or speed.
HEAD_MOUTH_SENSITIVITY=1.0
HEAD_MOUTH_MAX_OPENNESS=0.72
HEAD_MOUTH_SMOOTHING=0
HEAD_MOUTH_COMMAND_DEADBAND_DEG=0.5
# Quiet-final-phoneme floor, bounded by learned PCM silence; not a timing offset.
HEAD_MOUTH_FINAL_SPEECH_FLOOR_RATIO=0.02
# Persistent ALSA microphone capture/VAD for --listen.
HEAD_MIC_DEVICE=default
HEAD_MIC_VAD_RMS=450
# Ziggy ends an utterance after 1,000 ms silence; 300 ms pre-roll is always retained.
HEAD_MIC_SILENCE_MS=1000
# Wake-word conversation uses its own 1,000 ms end-of-speech timeout.
HEAD_ZIGGY_SILENCE_MS=1000
# Retry a genuinely interrupted persistent arecord stream (0-3); failures show exit code and ALSA stderr.
HEAD_MIC_RECOVERY_ATTEMPTS=2
