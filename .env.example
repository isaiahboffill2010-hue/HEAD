# Copy to .env.local and insert your key. Never commit .env.local.
GEMINI_API_KEY=replace_me
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Despina
GEMINI_THINKING=low
GEMINI_MAX_HISTORY_TURNS=4
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_RETRY_MAX_OUTPUT_TOKENS=2048
# Set to a supported model for word timing, or leave as shown for fallback.
GEMINI_ALIGN_MODEL=gemini-3.5-transcribe
# pulse is recommended for a Bluetooth speaker; auto falls back to ALSA.
HEAD_AUDIO_BACKEND=auto
# Positive milliseconds delay mouth motion to match Bluetooth acoustic latency.
HEAD_AUDIO_LATENCY_MS=0
# Additional mouth-only delay after HEAD_AUDIO_LATENCY_MS; tune physically.
HEAD_MOUTH_OFFSET_MS=0
